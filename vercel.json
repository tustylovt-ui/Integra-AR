{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.png",  "use": "@vercel/static" },
    { "src": "*.jpg",  "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/agendar", "dest": "/agendar.html" },
    { "src": "/facturar", "dest": "/facturar.html" },
    { "src": "/financiar", "dest": "/financiar.html" },
    { "src": "/lr", "dest": "/lr.html" },
    { "src": "/profesional", "dest": "/profesional.html" },
    { "src": "/tienda", "dest": "/tienda.html" },
    { "src": "/facturador-local", "dest": "/facturador-local.html" },
    { "src": "/instructivos/agendar", "dest": "/instructivo-agendar.html" },
    { "src": "/instructivos/facturar", "dest": "/instructivo-facturar.html" }
  ]
}
